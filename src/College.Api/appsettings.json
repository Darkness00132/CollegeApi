{
  "ConnectionStrings": {
    "collegedb": "Host=localhost;Port=5432;Database=collegedb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "CollegeApi",
    "Audience": "CollegeApi",
    "SecretKey": "dev-only-signing-key-change-me-0123456789abcdef-0123456789abcdef",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
