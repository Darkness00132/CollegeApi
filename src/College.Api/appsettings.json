{
  "ConnectionStrings": {
    "collegedb": "Host=localhost;Port=5432;Database=collegedb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "CollegeApi",
    "Audience": "CollegeApi",
    "SecretKey": "dev-only-signing-key-change-me-0123456789abcdef-0123456789abcdef",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "DefaultPolicyName": "Default",
    "Policies": {
      "Default": {
        "AllowedOrigins": [
          "capacitor://localhost",
          "ionic://localhost",
          "http://localhost"
        ],
        "AllowWildcardSubdomains": false,
        "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
        "AllowedHeaders": [ "Authorization", "Content-Type", "Accept", "traceparent", "tracestate", "X-Correlation-Id" ],
        "ExposedHeaders": [ "X-Correlation-Id" ],
        "AllowCredentials": false,
        "PreflightMaxAgeSeconds": 3600
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
