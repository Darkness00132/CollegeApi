    %% ==================== LECTURE SESSIONS ====================

    LECTURE_SESSION {
        uuid Id PK
        uuid SemesterCourseId FK
        uuid? ScheduleId FK
        uuid ProfessorId FK
        datetime StartsAt
        datetime EndsAt
    }

    %% ==================== SECTION SESSIONS ====================

    SECTION_SESSION {
        uuid Id PK
        uuid SemesterCourseId FK
        uuid? ScheduleId FK
        uuid AcademicAssistantId FK
        datetime StartsAt
        datetime EndsAt
    }

    %% ==================== LECTURE ATTENDANCE ====================

    LECTURE_ATTENDANCE {
        uuid LectureSessionId PK, FK
        uuid StudentId PK, FK
        string? Notes
    }

    %% ==================== SECTION ATTENDANCE ====================

    SECTION_ATTENDANCE {
        uuid SectionSessionId PK, FK
        uuid StudentId PK, FK
        string? Notes
    }

    %% ==================== EXTERNAL ACADEMIC RELATIONSHIPS ====================

    SEMESTER_COURSE ||--o{ LECTURE_SESSION : academic_affairs_reference
    SEMESTER_COURSE_SCHEDULE o|--o{ LECTURE_SESSION : planned_schedule_reference
    PROFESSOR_PROFILE ||--o{ LECTURE_SESSION : academic_affairs_reference

    SEMESTER_COURSE ||--o{ SECTION_SESSION : academic_affairs_reference
    SEMESTER_COURSE_SCHEDULE o|--o{ SECTION_SESSION : planned_schedule_reference
    ACADEMIC_ASSISTANT_PROFILE ||--o{ SECTION_SESSION : academic_affairs_reference

    STUDENT ||--o{ LECTURE_ATTENDANCE : academic_affairs_reference
    STUDENT ||--o{ SECTION_ATTENDANCE : academic_affairs_reference

    %% ==================== LOCAL ATTENDANCE RELATIONSHIPS ====================

    LECTURE_SESSION ||--o{ LECTURE_ATTENDANCE : records
    SECTION_SESSION ||--o{ SECTION_ATTENDANCE : records

